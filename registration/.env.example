# Supabase Project Settings > Data API / API Keys
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Optional: local demo only, set explicitly. Never set on the live Vercel project.
REGISTRATION_DEMO=false

# Administrator login password (server only). Use the password set by the organizer.
REGISTRATION_ADMIN_PASSWORD=
